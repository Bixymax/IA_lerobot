# Réglages propres au poste du local robot. Copier vers local.env (ignoré par git) :
#   cp local.env.example local.env     (setup_local.sh le fait pour vous)
# Puis : source local.env
# Les index changent à chaque branchement : relever avec  ./setup_local.sh

# Index /dev/videoN des VRAIES caméras Logitech C310
export SIDE=4
export TOP=2
export ANGLE45=0

# Ports des bras : lerobot-find-port (débrancher/rebrancher un bras) pour savoir lequel est lequel
export PORT_FOLLOWER=/dev/ttyACM0
export PORT_LEADER=/dev/ttyACM1
